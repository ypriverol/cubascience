.venv/

# LaTeX build junk (both language trees)
demographics/manuscript/*/latex/*.aux
demographics/manuscript/*/latex/*.bbl
demographics/manuscript/*/latex/*.blg
demographics/manuscript/*/latex/*.fdb_latexmk
demographics/manuscript/*/latex/*.fls
demographics/manuscript/*/latex/*.log
demographics/manuscript/*/latex/*.out
demographics/manuscript/*/latex/*.synctex.gz
demographics/manuscript/*/latex/*.png

# Codacy CLI local cache
.codacy/

# Duplicate LaTeX build PDFs (canonical copies live in manuscript/en/)
# Build outputs. The distributed copies live one level up, in manuscript/<lang>/.
# ES was asymmetrically tracked, so every ES rebuild dirtied the tree.
demographics/manuscript/*/latex/*.pdf
demographics/.mplconfig/

# Git worktrees (local agent isolation)
.worktrees/


#Ignore vscode AI rules
.github/instructions/codacy.instructions.md

# Third-party research PDFs: cited, not redistributed (see literature/SOURCES.md)
demographics/literature/sources.zip

# Analysis artifacts ARE part of the record: the manuscript cites them.
!demographics/artifacts/*.json
